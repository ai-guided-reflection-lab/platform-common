# Required services
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
OPENAI_API_KEY=""

# UNC Charlotte Google authentication
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
AUTH_MODE="school_google"
ALLOWED_GOOGLE_DOMAINS="charlotte.edu"
AUTH_SESSION_SECRET="generate-a-long-random-value"
AUTH_SESSION_MINUTES="60"
ALLOW_PASSWORD_LOGIN="true"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8001,http://localhost:8001,https://jamesonthehill.github.io,https://jamesonthehill.com"
ADMIN_EMAILS="your-admin-account@charlotte.edu"

# Require a uniquely linked GitHub account after school Google verification
REQUIRE_GITHUB_ACCOUNT="true"
GITHUB_CLIENT_ID="YOUR_GITHUB_OAUTH_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_OAUTH_CLIENT_SECRET"
GITHUB_CALLBACK_URL="https://socratic-chat-api.onrender.com/api/auth/github/callback"
FRONTEND_URL="https://jamesonthehill.com/Socratic-Chat/"

# Optional email/password registration; ignored in school_google mode
REQUIRE_EMAIL_VERIFICATION="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS="true"
EMAIL_CODE_EXPIRY_MINUTES="10"
