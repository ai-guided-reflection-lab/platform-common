# Required services
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
OPENAI_API_KEY=""
OPENAI_API_BASE_URL="https://api.openai.com/v1"
RAG_MODEL="gpt-4.1-mini"
# Chat provider: openai or groq. Embeddings always use the OpenAI settings above.
LLM_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_API_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_CLASSIFIER_MODEL="openai/gpt-oss-120b"
GROQ_ANSWER_EVALUATION_MODEL="openai/gpt-oss-120b"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS="1536"
# Accept a chunk when it has a sparse text match or reaches this cosine similarity.
RAG_MIN_DENSE_SIMILARITY="0.42"
RAG_MIN_SPARSE_SCORE="0.05"

# OpenAI fallback settings used only when LLM_PROVIDER="openai".
# With the default Groq provider, GROQ_CLASSIFIER_MODEL is used instead.
CLASSIFIER_ENABLED="true"
CLASSIFIER_MODEL=""
CLASSIFIER_TEMPERATURE="0"
CLASSIFIER_MAX_TOKENS="900"
CLASSIFIER_MAX_HISTORY="6"

# With the default Groq provider, GROQ_ANSWER_EVALUATION_MODEL is used instead.
ANSWER_EVALUATION_ENABLED="true"
ANSWER_EVALUATION_MODEL=""
ANSWER_EVALUATION_MAX_TOKENS="1600"

# UNC Charlotte authentication through a verified email on GitHub
AUTH_MODE="school_github"
ALLOWED_GITHUB_EMAIL_DOMAINS="charlotte.edu"
AUTH_SESSION_SECRET="generate-a-long-random-value"
AUTH_SESSION_MINUTES="60"
ALLOW_PASSWORD_LOGIN="true"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8001,http://localhost:8001,https://jamesonthehill.github.io,https://jamesonthehill.com"
ADMIN_EMAILS="your-admin-account@charlotte.edu"

# GitHub OAuth requests read-only email access; it never requests repository access.
REQUIRE_GITHUB_ACCOUNT="true"
GITHUB_CLIENT_ID="YOUR_GITHUB_OAUTH_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_OAUTH_CLIENT_SECRET"
GITHUB_CALLBACK_URL="https://socratic-chat-api.onrender.com/api/auth/github/callback"
FRONTEND_URL="https://jamesonthehill.com/Socratic-Chat/"

# Optional email/password registration; ignored in restricted school modes
REQUIRE_EMAIL_VERIFICATION="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS="true"
EMAIL_CODE_EXPIRY_MINUTES="10"
