# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# ── LLM ───────────────────────────────────────────────
# Global default — switch to "openai" to use OpenAI for all roles
LLM_PROVIDER=groq

# OpenAI — available for per-role overrides (e.g. TUTOR_LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Groq
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=llama3-8b-8192

# Per-role model overrides (provider inherits global LLM_PROVIDER unless overridden)
# EVALUATOR_GROQ_MODEL=llama3-8b-8192   # cheaper model for JSON judgments
# TUTOR_LLM_PROVIDER=openai             # override a single role to a different provider
# TUTOR_OPENAI_MODEL=gpt-4o

# ── LangSmith (optional tracing) ──────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls__your-key-here
LANGSMITH_PROJECT=reflections-app
