# Copy to .env. Use independent, random secrets for these two values.
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
PLATFORM_SERVICE_TOKEN=replace-with-a-different-long-random-service-secret

# Existing Socratic accounts/courses can be reused with their existing database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cluball
REFLECTIONS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cluball_reflections
REFLECTIONS_URL=http://127.0.0.1:8002
TUTOR_URL=http://127.0.0.1:8003

# Set school_google and configure Google for institutional sign-in.
AUTH_MODE=open
ALLOW_PASSWORD_LOGIN=true
REQUIRE_EMAIL_VERIFICATION=false
GOOGLE_CLIENT_ID=
ALLOWED_GOOGLE_DOMAINS=charlotte.edu
ADMIN_EMAILS=
REQUIRE_GITHUB_ACCOUNT=false
FRONTEND_URL=http://localhost:8000/
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

OPENAI_API_KEY=
GROQ_API_KEY=
FIRECRAWL_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
RAG_MODEL=gpt-4o-mini

# Used by the local Docker PostgreSQL service.
POSTGRES_PASSWORD=postgres
