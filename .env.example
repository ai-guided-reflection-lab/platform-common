# Copy to .env. Use independent, random secrets for these two values.
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
PLATFORM_SERVICE_TOKEN=replace-with-a-different-long-random-service-secret

# All PostgreSQL-backed apps share this database and use separate schemas.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cluball
PLATFORM_DB_SCHEMA=platform
SOCRATIC_DB_SCHEMA=socratic_chat
SHARED_RAG_DB_SCHEMA=shared_rag
SELF_DIRECTED_LEARNING_DB_SCHEMA=self_directed_learning
SELF_DIRECTED_LEARNING_URL=http://127.0.0.1:8100
# Outside Canvas only: explicitly select an existing approved local course.
PLATFORM_LOCAL_COURSE_CODE=
REFLECTIONS_DB_SCHEMA=reflections_app
REFLECTIONS_URL=http://127.0.0.1:8002
TUTOR_URL=http://127.0.0.1:8003

# Authentication modes: open, school_google, or school_github.
AUTH_MODE=open
ALLOW_PASSWORD_LOGIN=true
REQUIRE_EMAIL_VERIFICATION=false
GOOGLE_CLIENT_ID=
ALLOWED_GOOGLE_DOMAINS=charlotte.edu
ALLOWED_GITHUB_EMAIL_DOMAINS=charlotte.edu
# Optional GitHub login/linking. Create an OAuth App and use this callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
ADMIN_EMAILS=
REQUIRE_GITHUB_ACCOUNT=false
AUTH_SESSION_MINUTES=60
FRONTEND_URL=http://localhost:8000/
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Canvas LTI course navigation: shared origin and trusted Canvas instance.
# LTI 1.1 needs only these URLs plus a consumer key and shared secret.
LTI11_CONSUMER_KEY=
LTI11_SHARED_SECRET=
# First instructor assignment launch creates a linked draft; choose its chatbot.
# Course-navigation launches only open/create the course.
LTI_AUTO_CREATE_ASSIGNMENTS=true
LTI_CANVAS_ISSUER=https://instructure.charlotte.edu
CANVAS_API_ORIGIN=https://instructure.charlotte.edu
LTI_PUBLIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
FIRECRAWL_API_KEY=
LLM_PROVIDER=groq
# For local Qwen in Docker, set LLM_PROVIDER=ollama and run Ollama on the host.
OLLAMA_API_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_CLASSIFIER_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_ANSWER_EVALUATION_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_GENERATION_MAX_TOKENS=600
# Reflections instructor authoring only; independent of all student providers.
# Native gateway: use http://127.0.0.1:11434/v1 instead.
# Set PLATFORM_AGENT_MODEL= or PLATFORM_AGENT_API_BASE_URL= to disable.
PLATFORM_AGENT_PROVIDER=ollama
PLATFORM_AGENT_API_BASE_URL=http://host.docker.internal:11434/v1
PLATFORM_AGENT_API_KEY=ollama
PLATFORM_AGENT_MODEL=qwen3.5:9b-q4_K_M
PLATFORM_AGENT_TIMEOUT_SECONDS=60
PLATFORM_AGENT_MAX_TOOL_TURNS=4
PLATFORM_AGENT_MAX_TOOL_CALLS=6
OPENAI_MODEL=gpt-4o-mini
RAG_MODEL=gpt-4.1-mini
# Embeddings are independent of Groq chat. Run Ollama on the host.
# For a native server use OLLAMA_API_BASE_URL=http://127.0.0.1:11434/v1.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=64
RAG_MIN_DENSE_SIMILARITY=0.42
RAG_MIN_SPARSE_SCORE=0.05
CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL=
CLASSIFIER_TEMPERATURE=0
CLASSIFIER_MAX_TOKENS=900
CLASSIFIER_MAX_HISTORY=6
ANSWER_EVALUATION_ENABLED=true
ANSWER_EVALUATION_MODEL=
ANSWER_EVALUATION_MAX_TOKENS=1600
DEBUG_PIPELINE_LOGS=false

# Used only with `docker compose --profile local-db up`.
POSTGRES_PASSWORD=postgres
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CLASSIFIER_MODEL=openai/gpt-oss-20b
GROQ_ANSWER_EVALUATION_MODEL=openai/gpt-oss-20b
