# OpenAI is used for tutoring, assessment, and document embeddings.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Use a PostgreSQL connection string to store shared demo data. Leave blank for SQLite.
DATABASE_URL=
DATABASE_SCHEMA=self_directed_learning

# Chat provider: openai, groq, or demo. Groq also requires GROQ_API_KEY.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Use "demo" for deterministic local behavior without API calls.
ADAPTIVE_AI_MODE=openai
# Keep local presentations working if OpenAI rejects a key or is unavailable.
ADAPTIVE_ALLOW_DEMO_FALLBACK=true

# Separate local frontends.
INSTRUCTOR_ORIGIN=http://127.0.0.1:5173
STUDENT_ORIGIN=http://127.0.0.1:5174
