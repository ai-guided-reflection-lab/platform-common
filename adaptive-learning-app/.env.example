# OpenAI is used for tutoring, assessment, and document embeddings.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_AUTHORING_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DATABASE_URL is inherited from the root .env, shared with the platform,
# Socratic Chat, and Reflections. Configure the SDL schema there with
# SELF_DIRECTED_LEARNING_DB_SCHEMA=self_directed_learning.
# For an explicit offline SQLite session, start with -UseLocalSQLite.

# Chat provider: openai, groq, or demo. Groq also requires GROQ_API_KEY.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Use "demo" for deterministic local behavior without API calls.
ADAPTIVE_AI_MODE=openai
# Report provider failures instead of silently switching to demo mode.
ADAPTIVE_ALLOW_DEMO_FALLBACK=false

# Separate local frontends.
INSTRUCTOR_ORIGIN=http://127.0.0.1:5173
STUDENT_ORIGIN=http://127.0.0.1:5174

# PDF indexing only; preview retains its existing pypdf response.
PDF_CHUNK_MAX_TOKENS=512
# Optional directory of prefetched Docling layout/table/OCR model artifacts.
PDF_MODEL_ARTIFACTS_PATH=

# Slide/HTML token budget, including repeated title/section context.
RESOURCE_CHUNK_MAX_TOKENS=512
